; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

[application]

config/name="Defensa Orbital"
run/main_scene="res://Componentes/Esenas/Menu/Menu.tscn"
boot_splash/image="res://DupsterGames.png"
boot_splash/bg_color=Color( 0, 0, 0, 1 )
config/icon="res://Icon.png"

[autoload]

GLOBAL="*res://GLOBAL.gd"

[display]

window/size/width=144
window/size/height=256
window/size/test_width=720
window/size/test_height=1280
window/handheld/orientation="portrait"
window/stretch/mode="2d"
window/stretch/aspect="keep_width"

